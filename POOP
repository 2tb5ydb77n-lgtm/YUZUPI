local AURA_RADIUS = 20; local BLOW_FORCE = 5000; local SCAN_INTERVAL = 0.10
local autoBlowActive = false; local autoBlowConnection = nil
local antiFlingConnection = nil; local lastBlowTime = {}
local function getMyToyFolder() return Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys") end
local function getAllCharacters()
	local list = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then table.insert(list, pl.Character) end
	end
	return list
end
local function isDescendantOfAnyCharacter(part)
	if not part then return false end
	for _, c in ipairs(getAllCharacters()) do
		if part:IsDescendantOf(c) then return true end
	end
	return false
end
local function isCharacterBodyPart(part)

if not part or not part.Parent then return false end
	if isDescendantOfAnyCharacter(part) then return true end
	local root = part.AssemblyRootPart
	if root and isDescendantOfAnyCharacter(root) then return true end
	return false
end
local function breakJointsToCharacter(part)
	if not part or not part:IsA("BasePart") then return end
	local toDestroy = {}
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("JointInstance") or child:IsA("WeldConstraint") or child:IsA("Motor6D") or child:IsA("RigidConstraint") or child:IsA("Weld") or child:IsA("Motor") or child:IsA("Snap") then
			table.insert(toDestroy, child)
		end
	end
	local parent = part.Parent
	if parent and parent:IsA("Model") then
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("JointInstance") or child:IsA("WeldConstraint") or child:IsA("Motor6D") or child:IsA("RigidConstraint") then
				table.insert(toDestroy, child)
			end
		end
	end
	for _, j in ipairs(toDestroy) do pcall(function() j:Destroy() end) end
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("WeldConstraint") then pcall(function() child.Enabled = false end) end
	end
end
local function isTargetPart(part)
	if not part or not part.Parent then return false end
	if not part:IsA("BasePart") then return false end
	if part.Anchored then return false end
	if isCharacterBodyPart(part) then return false end
	local tf = getMyToyFolder()
	if tf and part:IsDescendantOf(tf) then return false end
	return true
end
local function startAntiFling()
	if antiFlingConnection then return end
	antiFlingConnection = RunService.Heartbeat:Connect(function()
		if not autoBlowActive then return end
		local char = localPlayer.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		if hrp.AssemblyLinearVelocity.Magnitude > 200 then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.Velocity = Vector3.zero
		end
	end)
end
local function stopAntiFling()
	if antiFlingConnection then antiFlingConnection:Disconnect(); antiFlingConnection = nil end
end
local function blowPart(part, centerPos)
	if not part or not part.Parent or isCharacterBodyPart(part) then return end
	breakJointsToCharacter(part)
	task.wait(0.01)
	local dir = part.Position - centerPos
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.5 then
		local angle = math.random() * math.pi * 2
		dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
	else dir = dir.Unit end
	if setNetworkOwner then pcall(function() setNetworkOwner:FireServer(part, part.CFrame) end) end
	pcall(function()
		part.AssemblyLinearVelocity = dir * BLOW_FORCE
		part.AssemblyAngularVelocity = Vector3.new((math.random()-0.5)*100, (math.random()-0.5)*200, (math.random()-0.5)*100)
	end)
	local existing = part:FindFirstChild("AutoBlowBV")
	if existing then existing:Destroy() end
	local bv = Instance.new("BodyVelocity")
	bv.Name = "AutoBlowBV"
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bv.P = 5000; bv.Velocity = dir * BLOW_FORCE
	bv.Parent = part
	game:GetService("Debris"):AddItem(bv, 0.5)
end
local function startAutoBlow()
	if autoBlowConnection then return end
	autoBlowActive = true; lastBlowTime = {}
	startAntiFling()
	autoBlowConnection = RunService.Heartbeat:Connect(function()
		if not autoBlowActive then return end
		local now = tick()
		if now - (lastBlowTime.__scan or 0) < SCAN_INTERVAL then return end
		lastBlowTime.__scan = now
		local char = localPlayer.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
		if not hrp then return end
		local centerPos = hrp.Position
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local excludeList = {}
		for _, c in ipairs(getAllCharacters()) do table.insert(excludeList, c) end
		local tf = getMyToyFolder()
		if tf then table.insert(excludeList, tf) end
		params.FilterDescendantsInstances = excludeList
		local ok, parts = pcall(function() return Workspace:GetPartBoundsInRadius(centerPos, AURA_RADIUS, params) end)
		if not ok or not parts then return end
		local processed = {}
		for _, part in ipairs(parts) do
			if isTargetPart(part) then
				local root = part.AssemblyRootPart or part
				if not processed[root] and not isCharacterBodyPart(root) then
					processed[root] = true
					local last = lastBlowTime[root] or 0
					if now - last >= 0.3 then
						lastBlowTime[root] = now
						blowPart(root, centerPos)
					end
				end
			end
		end
	end)
end
local function stopAutoBlow()
	autoBlowActive = false
	if autoBlowConnection then autoBlowConnection:Disconnect(); autoBlowConnection = nil end
	stopAntiFling(); lastBlowTime = {}
end

