_G.NoclipAura = _G.NoclipAura or false
local AURA_DISTANCE = 100
local noclipConnection = nil
local auraFallenPlayers = setmetatable({}, { __mode = "k" })
local originalCollide = setmetatable({}, { __mode = "k" })
local function startFallingForPlayer(player)
	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	if auraFallenPlayers[player] then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then pcall(function() part.CanCollide = false end) end
		end
		return
	end
	auraFallenPlayers[player] = true
	originalCollide[player] = {}
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			originalCollide[player][part] = part.CanCollide
			pcall(function() part.CanCollide = false end)
		end
	end
	pcall(function() hrp.Anchored = false end)
	pcall(function()
		hum.PlatformStand = true
		hum.Sit = false
		hum.AutoRotate = false
		hum:ChangeState(Enum.HumanoidStateType.Physics)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end)
	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.new(0, -500, 0)
		hrp.Velocity = Vector3.new(0, -500, 0)
	end)
	task.spawn(function()
		local bv = Instance.new("BodyVelocity")
		bv.Name = "HakiFallBV"
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.new(0, -300, 0)
		bv.Parent = hrp
		game:GetService("Debris"):AddItem(bv, 3)
	end)
	task.spawn(function()
		local st = tick()
		while auraFallenPlayers[player] and character.Parent and tick() - st < 5 do
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then pcall(function() part.CanCollide = false end) end
			end
			if hum.Parent then
				pcall(function()
					hum.PlatformStand = true
					hum:ChangeState(Enum.HumanoidStateType.Freefall)
				end)
			end
			task.wait(0.05)
		end
	end)
end
local function resetPlayerState(player)
	local character = player.Character
	if not character then auraFallenPlayers[player] = nil; originalCollide[player] = nil; return end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum.PlatformStand = false
			hum.AutoRotate = true
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end
	local saved = originalCollide[player]
	if saved then
		for part, collide in pairs(saved) do
			if part and part.Parent then pcall(function() part.CanCollide = collide end) end
		end
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then local bv = hrp:FindFirstChild("HakiFallBV"); if bv then bv:Destroy() end end
	auraFallenPlayers[player] = nil
	originalCollide[player] = nil
end
