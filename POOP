	gkSpawnAndBreak(targetPart)
	return true
end
local function gkRestore()
	for part, data in pairs(gkOriginalData) do
		if part and part.Parent then
			pcall(function()
				part.CanCollide = data.CanCollide
				part.CustomPhysicalProperties = data.CustomPhysicalProperties
				part.Transparency = data.Transparency
			end)
		end
	end
	gkOriginalData = {}
end
local function gkStart()
	if gkEnabled then return end
	gkEnabled = true
	local tp = gkFindCenterGround()
	if tp then gkDisableGround(tp); _NOTIFY("地面キック: 開始")
	else _NOTIFY("地面キック: 中央の地面が見つかりません") end
end
local function gkStop()
	if not gkEnabled then return end
	gkEnabled = false
	gkRestore(); gkCleanupShurikens()
	_NOTIFY("地面キック: 停止")
end

