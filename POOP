local function ApplyTitleGlow(titleLabel)
	if titleLabel:FindFirstChild("PoopGlowLayer1") then return end
	if not titleLabel.Text or not titleLabel.Text:find("Poop") then return end

	local glowLabels = {}
	local originalText = titleLabel.Text
	local originalRich = titleLabel.RichText
	local originalFont = titleLabel.Font
	local originalXAlign = titleLabel.TextXAlignment
	local originalYAlign = titleLabel.TextYAlignment

	local offsets = {
		{ x = -1, y = -1, t = 0.82 },
		{ x =  1, y = -1, t = 0.82 },
		{ x = -1, y =  1, t = 0.82 },
		{ x =  1, y =  1, t = 0.82 },
		{ x = -2, y =  0, t = 0.88 },
		{ x =  2, y =  0, t = 0.88 },
		{ x =  0, y = -2, t = 0.88 },
		{ x =  0, y =  2, t = 0.88 },
	}

	for i, off in ipairs(offsets) do
		local g = Instance.new("TextLabel")
		g.Name = "PoopGlowLayer" .. i
		g.BackgroundTransparency = 1
		g.Size = UDim2.new(1, 0, 1, 0)
		g.Position = UDim2.new(0, off.x, 0, off.y)
		g.Text = originalText
		g.RichText = originalRich
		g.TextColor3 = Color3.fromRGB(255, 255, 255)
		g.TextSize = titleLabel.TextSize
		g.Font = originalFont
		g.TextXAlignment = originalXAlign
		g.TextYAlignment = originalYAlign
		g.TextTransparency = off.t
		g.ZIndex = math.max(0, (titleLabel.ZIndex or 1) - 1)
		g.Parent = titleLabel
		table.insert(glowLabels, { label = g, baseTrans = off.t })
	end

	titleLabel:GetPropertyChangedSignal("TextSize"):Connect(function()
		for _, g in ipairs(glowLabels) do
			if g.label.Parent then
				g.label.TextSize = titleLabel.TextSize
			end
		end
	end)

	local stroke = Instance.new("UIStroke")
	stroke.Name = "PoopGlowStroke"
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 3
	stroke.Transparency = 0.35
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = titleLabel

	task.spawn(function()
		local t = 0
		while titleLabel.Parent do
			t = t + 0.05
			local p = math.sin(t) * 0.5 + 0.5
			for _, g in ipairs(glowLabels) do
				if g.label.Parent then
					g.label.TextTransparency = g.baseTrans - p * 0.12
				end
			end
			if stroke.Parent then
				stroke.Transparency = 0.4 - p * 0.25
				stroke.Thickness = 2 + p * 4
			end
			task.wait(0.03)
		end
	end)
end

local function EnlargeTabsAndTitle()
	local CoreGui = game:GetService("CoreGui")
	local guiRoot
	for _, child in ipairs(CoreGui:GetChildren()) do
		if child:IsA("ScreenGui") and (child.Name == "Obsidian" or child.Name:lower():find("obsidian")) then
			guiRoot = child; break
		end
	end
	if not guiRoot then return end

	local function findSidebar(obj)
		local n = (obj.Name or ""):lower()
		if n:find("sidebar") then return obj end
		for _, c in ipairs(obj:GetChildren()) do
			if c:IsA("GuiObject") then
				local r = findSidebar(c)
				if r then return r end
			end
		end
		return nil
	end

	local sidebar = findSidebar(guiRoot)
	if sidebar then
		local function scanTab(obj)
			if obj:IsA("TextLabel") or obj:IsA("TextButton") then
				pcall(function()
					obj.TextSize = math.floor(obj.TextSize * 1.6)
					obj.Font = Enum.Font.GothamBold
				end)
			end
			for _, c in ipairs(obj:GetChildren()) do
				if c:IsA("GuiObject") then scanTab(c) end
			end
		end
		scanTab(sidebar)
	end

	local function scanTitle(obj)
		if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Poop") then
			local n = (obj.Name or ""):lower()
			if n == "title" or n == "windowtitle" or n:find("title") then
				pcall(function()
					obj.TextSize = math.floor(obj.TextSize * 1.5)
					obj.Font = Enum.Font.GothamBold
					obj.TextXAlignment = Enum.TextXAlignment.Left
					obj.TextScaled = false
					obj.AnchorPoint = Vector2.new(0, obj.AnchorPoint.Y)
					if obj.Parent then
						obj.Position = UDim2.new(0, 12, 0.5, 0)
					else
						obj.Position = UDim2.new(0, 12, obj.Position.Y.Scale, obj.Position.Y.Offset)
					end
					obj.Size = UDim2.new(0.7, 0, obj.Size.Y.Scale, obj.Size.Y.Offset)
				end)
				pcall(ApplyTitleGlow, obj)
			end
		end
		for _, c in ipairs(obj:GetChildren()) do
			if c:IsA("GuiObject") then scanTitle(c) end
		end
	end
	scanTitle(guiRoot)

	local function forceLeftPoop(obj)
		if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Poop") then
			pcall(function()
				obj.TextXAlignment = Enum.TextXAlignment.Left
				obj.TextScaled = false
				obj.AnchorPoint = Vector2.new(0, obj.AnchorPoint.Y)
				obj.Position = UDim2.new(0, 12, 0.5, 0)
			end)
			pcall(ApplyTitleGlow, obj)
		end
		for _, c in ipairs(obj:GetChildren()) do
			if c:IsA("GuiObject") then forceLeftPoop(c) end
		end
	end
	forceLeftPoop(guiRoot)
end

