isWhitelisted = isWhitelisted or function(arg)
	if not tbl2.kickUseWhitelist then return false end
	if arg == localPlayer then return true end
	if localPlayer:IsFriendsWith(arg.UserId) then return true end
	return false
end
local KickState = {
	Running = false,
	PlayerList = Players:GetPlayers(),
	Cooldowns = setmetatable({}, { __mode = "k" }),
	LagLines = 11,
	LagServer = false,
}
Players.PlayerAdded:Connect(function(player) table.insert(KickState.PlayerList, player) end)
Players.PlayerRemoving:Connect(function(player)
	local idx = table.find(KickState.PlayerList, player)
	if idx then table.remove(KickState.PlayerList, idx) end
end)
local function GetKickTargets()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer then
			if tbl2.kickExcludeFriends and localPlayer:IsFriendsWith(p.UserId) then
			elseif tbl2.kickUseWhitelist and isWhitelisted(p) then
			else table.insert(list, p) end
		end
	end
	return list
end
local LagLoopActive = false
local function StartLagLoop()
	if LagLoopActive then return end
	LagLoopActive = true
	task.spawn(function()
		while KickState.LagServer and not KickState.__unloaded do
			refreshRemotes()
			local sl = Workspace:FindFirstChild("SpawnLocation")
			if sl and tbl23.cgl then
				local n36 = -2 ^ (20 + KickState.LagLines)
				pcall(function() tbl23.cgl:FireServer(sl, CFrame.new(n36, 0, n36)) end)
			end
			task.wait()
		end
		LagLoopActive = false
	end)
end
local function KickServer()
	if KickState.Running then return false end
	local now = os.clock()
	local targets = {}
	for _, p in ipairs(GetKickTargets()) do
		local _, hrp, hum = tbl17.charp(p)
		if hrp and hum and hum.Health > 0 then
			if now - (KickState.Cooldowns[p] or -math.huge) >= 15 then
				table.insert(targets, p)
			end
		end
	end
	if #targets == 0 then return false end
	KickState.Running = true
	KickState.LagServer = true
	StartLagLoop()
	local parts = {}
	local cframes = {}
	local connection = nil
	local ok, result = pcall(function()
		local _, myHrp, myHum = tbl17.charp()
		if not myHrp or not myHum or myHum.Health <= 0 then return end
		local originPos = myHrp.Position
		connection = RunService.Heartbeat:Connect(function()
			for part, cf in pairs(cframes) do
				if part.Parent then part.CFrame = cf; tbl17.resetVelocity(part)
				else cframes[part] = nil end
			end
		end)
		for i, p in ipairs(targets) do
			local _, hrp, hum = tbl17.charp(p)
			if hrp and hum and hum.Health > 0 then
				KickState.Cooldowns[p] = os.clock()
				if tbl17.sno(hrp) then
					local angle = i / #targets * math.pi * 2
					table.insert(parts, hrp)
					cframes[hrp] = CFrame.new(originPos + Vector3.new(math.cos(angle) * 15, 15, math.sin(angle) * 15))
					tbl17.teleport(hrp, cframes[hrp])
				end
			end
		end
		for i, hrp in ipairs(parts) do
			local angle = i / #parts * math.pi * 2
			cframes[hrp] = CFrame.new(originPos + Vector3.new(math.cos(angle) * 15, 15, math.sin(angle) * 15))
		end
		RunService.Heartbeat:Wait()
	end)
	task.spawn(function()
		local et = os.clock() + 3
		while not KickState.__unloaded and os.clock() < et do RunService.Heartbeat:Wait() end
		if connection then connection:Disconnect(); connection = nil end
	end)
	task.wait(0.15)
	for _, hrp in ipairs(parts) do if hrp.Parent then tbl17.unsno(hrp) end end
	for _, hrp in ipairs(parts) do if not KickState.__unloaded and hrp.Parent then task.spawn(tbl17.removesticky, hrp.Parent) end end
	task.wait(6)
	KickState.LagServer = false
	KickState.Running = false
	if not ok then warn("[Hub] KickServer failed: " .. tostring(result)) end
	return ok and #parts > 0
end

